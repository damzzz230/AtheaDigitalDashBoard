# Copy names only. Real values live in the Netlify UI (Site settings > Environment variables),
# never in this repo. Generate hashes with: npm run hash-pass
DAMZ_PASS_HASH=
DAS_PASS_HASH=
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional: enables the daily PageSpeed Insights Lighthouse score on the Sites screen
PAGESPEED_API_KEY=
