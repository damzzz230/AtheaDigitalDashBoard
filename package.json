{
  "name": "athea-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "screenshots": "playwright test",
    "hash-pass": "node scripts/hash-pass.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "framer-motion": "14.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@netlify/blobs": "11.1.6",
    "@netlify/functions": "6.0.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  }
}
